// Decisión arquitectónica: Definimos dos modelos en esta fase.
// User: entidad central del sistema.
// VocationalAssessment: representa una sesión de evaluación vocacional completa.
// La separación en tabla propia (en vez de columnas en User) sigue SRP:
// un usuario puede tener múltiples evaluaciones en el futuro.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

//
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments    VocationalAssessment[]
  icfesAnalyses   IcfesAnalysis[]
  chatConversations ChatConversation[]

  @@map("users")
}

model VocationalAssessment {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Array de { questionId, category, type, value }
  rawAnswers Json

  // Scores CHASIDE: { C: 12, H: 4, A: 8, S: 6, I: 13, D: 3, E: 7 }
  scores     Json?

  // Contexto adicional procesado: { location: [...], interest: [...], activity: [...] }
  contextData Json?

  // Resultado del motor vocacional adaptativo basado en áreas A1-A12.
  vocationalProfile Json?
  vocationalResults Json?
  assessmentType String @default("LEGACY")
  engineVersion String?
  questionnaireVersion String?
  scoringVersion String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  currentPhase String?

  // Respuesta estructurada de Claude
  aiAnalysis        String?
  topCareers        Json?
  notRecommended    Json?
  idealEnvironment  String?

  status    AssessmentStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  answers       AssessmentAnswer[]
  phaseEvents   AssessmentPhaseEvent[]
  areaResults   AssessmentAreaResult[]

  @@map("vocational_assessments")
}

model AssessmentAnswer {
  id            String @id @default(uuid())
  assessmentId  String
  assessment    VocationalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId    String
  phase         String
  answerValue   Json
  position      Int
  answeredAt    DateTime @default(now())
  questionText  String?
  questionType  String?
  options       Json?

  @@unique([assessmentId, questionId])
  @@index([assessmentId, phase])
  @@index([questionId])
  @@map("assessment_answers")
}

model AssessmentPhaseEvent {
  id           String @id @default(uuid())
  assessmentId String
  assessment   VocationalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  eventId      String @unique
  phase        String
  eventType    String
  questionId   String?
  timestamp    DateTime @default(now())
  metadata     Json?

  @@index([assessmentId, timestamp])
  @@index([assessmentId, phase, eventType])
  @@map("assessment_phase_events")
}

model AssessmentAreaResult {
  id           String @id @default(uuid())
  assessmentId String
  assessment   VocationalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  areaId       String
  score        Float
  confidence   Float
  rank         Int
  percentage   Float?
  dimensions   Json?

  @@unique([assessmentId, areaId])
  @@index([areaId, rank])
  @@map("assessment_area_results")
}

model IcfesAnalysis {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName             String?
  fileSize             Int?
  sourceHash           String?
  candidateName        String?
  registrationNumber   String?
  applicationDate      String?
  publicationDate      String?
  municipalityDepartment String?
  institution          String?
  globalScore          Int
  globalPercentile     Int?
  subjectScores        Json
  strengths            Json
  weaknesses           Json
  recommendations      Json
  summary              String
  status               IcfesAnalysisStatus @default(PROCESSED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("icfes_analyses")
}

model ChatConversation {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextSignature  String
  topic             String         @default("VOCATIONAL")
  summary           String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  messages          ChatMessage[]

  @@index([userId, contextSignature])
  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id                 String           @id @default(uuid())
  conversationId     String
  conversation       ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contextSignature   String
  role               String
  content            String
  normalizedContent  String
  turnKey            String
  cacheSourceTurnKey String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([conversationId, createdAt])
  @@index([contextSignature, role])
  @@index([contextSignature, normalizedContent])
  @@map("chat_messages")
}

enum Role {
  STUDENT
  COUNSELOR
  ADMIN
}

enum AssessmentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum IcfesAnalysisStatus {
  PROCESSED
  FAILED
}
